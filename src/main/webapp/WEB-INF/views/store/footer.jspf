<footer class="site-footer">
  <div class="footer-grid container">
    <div class="footer-col" id="about">
      <h3>About Krishak</h3>
      <p>
        Connecting farmers directly with consumers, bringing fresh, organic produce straight from the farm to your table.
      </p>
    </div>
    <div class="footer-col">
      <h3>Quick Links</h3>
      <ul class="footer-links">
        <li><a href="${pageContext.request.contextPath}/landing#top">Home</a></li>
        <li><a href="${pageContext.request.contextPath}/browse">Products</a></li>
        <li><a href="#" onclick="return false;">About Us</a></li>
        <li><a href="#" onclick="return false;">Contact</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h3>Contact Us</h3>
      <ul class="footer-contact">
        <li>
          <img src="${pageContext.request.contextPath}/image/phone.svg" alt="" width="18" height="18" />
          <a href="tel:+9779876543210">+977 9876543210</a>
        </li>
        <li>
          <img src="${pageContext.request.contextPath}/image/email.svg" alt="" width="18" height="18" />
          <a href="mailto:hello@krishak.com">hello@krishak.com</a>
        </li>
        <li>
          <img src="${pageContext.request.contextPath}/image/location.svg" alt="" width="18" height="18" />
          <span>12 Matepani, Pokhara, Gandaki 33700</span>
        </li>
      </ul>
    </div>
    <div class="footer-col">
      <h3>Follow Us</h3>
      <div class="social-row" aria-label="Social media">
        <a class="social-btn" href="#" onclick="return false;" aria-label="Facebook"><img src="${pageContext.request.contextPath}/image/logo.svg" alt="" /></a>
        <a class="social-btn" href="#" onclick="return false;" aria-label="Twitter"><img src="${pageContext.request.contextPath}/image/bird.png" alt="" /></a>
        <a class="social-btn" href="#" onclick="return false;" aria-label="Instagram"><img src="${pageContext.request.contextPath}/image/logo.svg" alt="" /></a>
        <a class="social-btn" href="#" onclick="return false;" aria-label="LinkedIn"><img src="${pageContext.request.contextPath}/image/logo.svg" alt="" /></a>
      </div>
    </div>
  </div>

  <div class="footer-bar">
    <div class="container footer-bar-inner">
      <p>© 2026 Krishak. All rights Reserved. | <a href="#" onclick="return false;">Privacy Policy</a> | <a href="#" onclick="return false;">Terms of Service</a></p>
    </div>
  </div>
</footer>
