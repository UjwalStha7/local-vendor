<header class="site-header" id="top">
  <div class="header-inner">
    <a class="logo" href="${pageContext.request.contextPath}/landing">
      <img class="logo-mark" src="${pageContext.request.contextPath}/image/logo.svg" alt="" width="28" height="28" />
      <span>Krishak</span>
    </a>
    <nav class="main-nav" aria-label="Primary">
      <a href="${pageContext.request.contextPath}/landing#top">Home</a>
      <a href="${pageContext.request.contextPath}/browse">Product</a>
      <a href="javascript:void(0)" class="nav-inert">About Us</a>
      <a href="javascript:void(0)" class="nav-inert">Contact</a>
    </nav>
    <a class="cart-link" href="${pageContext.request.contextPath}/cart" aria-label="Shopping cart">
      <img class="cart-icon" src="${pageContext.request.contextPath}/image/cart.svg" alt="" width="24" height="24" />
      <span class="cart-badge${cartCount == 0 ? ' cart-badge--empty' : ''}" aria-live="polite">${cartCount}</span>
    </a>
  </div>
</header>

